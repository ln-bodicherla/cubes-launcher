<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/wpBackground">

    <!-- Spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Large time display -->
    <TextView
        android:id="@+id/timeDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="00:00:00.00"
        android:textColor="?attr/wpTextPrimary"
        android:textSize="72sp"
        android:fontFamily="@font/selawik_light"
        android:paddingStart="24dp"
        android:paddingEnd="24dp" />

    <!-- Spacer -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Laps RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lapsRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:clipToPadding="false" />

    <!-- Bottom button row (boxy style) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lapResetButton"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:gravity="center"
            android:text="@string/stopwatch_lap"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="24sp"
            android:fontFamily="@font/selawik_regular"
            android:textAllCaps="false"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect" />

        <TextView
            android:id="@+id/startStopButton"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/stopwatch_start"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="24sp"
            android:fontFamily="@font/selawik_regular"
            android:textAllCaps="false"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect" />

    </LinearLayout>

</LinearLayout>
