<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <ImageView
        android:id="@+id/voicemailIcon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_phone_voicemail"
        android:contentDescription="@string/phone_tab_voicemail" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/phone_voicemail_title"
        android:textColor="?attr/wpTextPrimary"
        android:textSize="26sp"
        android:fontFamily="@font/selawik_semilight"
        android:paddingTop="20dp" />

    <!-- Voicemail number display -->
    <TextView
        android:id="@+id/voicemailNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/wpTextSecondary"
        android:textSize="17sp"
        android:fontFamily="@font/selawik_regular"
        android:paddingTop="4dp"
        android:visibility="gone" />

    <!-- Error / status message -->
    <TextView
        android:id="@+id/voicemailStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/wpTextSecondary"
        android:textSize="17sp"
        android:fontFamily="@font/selawik_regular"
        android:paddingTop="4dp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Call Voicemail button (boxy style) -->
    <TextView
        android:id="@+id/callVoicemailButton"
        android:layout_width="200dp"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/phone_voicemail_call"
        android:textColor="?attr/wpTextPrimary"
        android:textSize="17sp"
        android:fontFamily="@font/selawik_regular"
        android:textAllCaps="false"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_phone_bottom_button"
        android:visibility="gone" />

</LinearLayout>
