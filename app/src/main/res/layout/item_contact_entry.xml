<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_dial_key_rect"
    android:layout_marginBottom="1dp">

    <!-- Initials circle -->
    <TextView
        android:id="@+id/contactInitials"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:textColor="@color/wp_white"
        android:textSize="20sp"
        android:fontFamily="@font/selawik_regular"
        android:background="@drawable/bg_contact_initials_circle" />

    <!-- Name + number -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/contactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="20sp"
            android:fontFamily="@font/selawik_regular"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/contactNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="15sp"
            android:fontFamily="@font/selawik_regular"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Chevron -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=">"
        android:textColor="?attr/wpTextSecondary"
        android:textSize="20sp"
        android:fontFamily="@font/selawik_light" />

</LinearLayout>
