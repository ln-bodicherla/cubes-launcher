<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/wpBackground">

    <!-- Header: name + number -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/contactName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="40sp"
            android:fontFamily="@font/selawik_light"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/contactNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="18sp"
            android:fontFamily="@font/selawik_regular"
            android:paddingTop="4dp" />

    </LinearLayout>

    <!-- Action buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/actionCall"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_phone_call"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_call"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionMessage"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_phone_message"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_message"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actionOpenContact"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_info"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/openContactLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_info_open_contact"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular" />
        </LinearLayout>

    </LinearLayout>

    <!-- Call history label -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/phone_tab_history"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:textSize="16sp"
        android:fontFamily="@font/selawik_semibold"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="24dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/wpTextSecondary" />

    <!-- Call history list for this number -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/callListRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="24dp" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/phone_info_no_history"
        android:textColor="?attr/wpTextSecondary"
        android:textSize="17sp"
        android:fontFamily="@font/selawik_regular"
        android:visibility="gone" />

</LinearLayout>
