<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_message_sent"
        android:padding="@dimen/message_bubble_padding">

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wp_white"
            android:textSize="@dimen/message_body_size"
            android:fontFamily="@font/selawik_regular" />

    </LinearLayout>

    <TextView
        android:id="@+id/deliveryStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="12dp"
        android:textColor="?attr/wpTextSecondary"
        android:textSize="@dimen/message_delivery_size"
        android:fontFamily="@font/selawik_regular"
        android:visibility="gone" />

</FrameLayout>
