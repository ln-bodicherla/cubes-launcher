<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="?attr/selectableItemBackground">

    <TextView
        android:id="@+id/contactInitials"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:textColor="@color/wp_white"
        android:textSize="18sp"
        android:fontFamily="@font/selawik_semibold"
        android:background="@drawable/bg_contact_initials_circle" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/contactName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="@dimen/message_contact_name_size"
                android:fontFamily="@font/selawik_regular"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="@dimen/message_timestamp_size"
                android:fontFamily="@font/selawik_regular"
                android:paddingStart="8dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/messagePreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="@dimen/message_preview_size"
            android:fontFamily="@font/selawik_regular"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>
