<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/statusBar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/status_bar_height"
    android:orientation="horizontal"
    android:gravity="bottom"
    android:paddingTop="@dimen/status_bar_top_inset"
    android:paddingBottom="4dp"
    android:paddingStart="@dimen/status_bar_padding_horizontal"
    android:paddingEnd="@dimen/status_bar_padding_horizontal"
    android:background="@color/transparent">

    <!-- Left side: notification icons -->
    <LinearLayout
        android:id="@+id/notificationIconsContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="true" />

    <!-- Right side: system indicators -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/signalIcon"
            android:layout_width="@dimen/status_bar_icon_size"
            android:layout_height="@dimen/status_bar_icon_size"
            android:src="@drawable/ic_signal_4"
            android:contentDescription="Signal strength"
            android:layout_marginEnd="6dp" />

        <ImageView
            android:id="@+id/wifiIcon"
            android:layout_width="@dimen/status_bar_icon_size"
            android:layout_height="@dimen/status_bar_icon_size"
            android:src="@drawable/ic_wifi_4"
            android:contentDescription="WiFi strength"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/batteryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wp_white"
            android:textSize="@dimen/status_bar_text_size"
            android:fontFamily="@font/selawik_regular"
            android:layout_marginEnd="8dp"
            tools:text="85%" />

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wp_white"
            android:textSize="@dimen/status_bar_text_size"
            android:fontFamily="@font/selawik_regular"
            tools:text="10:30" />

    </LinearLayout>

</LinearLayout>
