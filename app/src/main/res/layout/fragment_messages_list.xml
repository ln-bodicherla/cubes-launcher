<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/wpBackground">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/conversationsRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="16dp" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/messages_empty"
        android:textColor="?attr/wpTextSecondary"
        android:textSize="18sp"
        android:fontFamily="@font/selawik_regular"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/fabNewMessage"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@drawable/ic_messages_new"
        android:scaleType="center"
        android:contentDescription="@string/messages_new_message"
        android:background="@null" />

</FrameLayout>
