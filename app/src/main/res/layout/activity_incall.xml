<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/wpBackground">

    <!-- Caller info (top-aligned, left-aligned, WP style) -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp">

        <TextView
            android:id="@+id/callerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="46sp"
            android:fontFamily="@font/selawik_light"
            android:gravity="start"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/callerNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="20sp"
            android:fontFamily="@font/selawik_regular"
            android:gravity="start"
            android:paddingTop="4dp" />

        <TextView
            android:id="@+id/callState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="20sp"
            android:fontFamily="@font/selawik_regular"
            android:gravity="start"
            android:paddingTop="8dp" />

        <TextView
            android:id="@+id/callTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="20sp"
            android:fontFamily="@font/selawik_regular"
            android:gravity="start"
            android:paddingTop="4dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Spacer: pushes controls to bottom -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Incoming: answer / decline (boxy rectangles) -->
    <LinearLayout
        android:id="@+id/incomingControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/answerButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:gravity="center"
            android:text="@string/phone_answer"
            android:textColor="@color/wp_white"
            android:textSize="18sp"
            android:fontFamily="@font/selawik_regular"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_answer_call_button" />

        <TextView
            android:id="@+id/declineButton"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:layout_weight="1"
            android:layout_marginBottom="1dp"
            android:gravity="center"
            android:text="@string/phone_decline"
            android:textColor="@color/wp_white"
            android:textSize="18sp"
            android:fontFamily="@font/selawik_regular"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_end_call_button" />

    </LinearLayout>

    <!-- Active call controls (boxy rectangles in a grid) -->
    <LinearLayout
        android:id="@+id/activeControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Control row 1: mute, keypad -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/muteButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="1dp"
                android:layout_marginBottom="1dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_incall_control_rect">
                <ImageView
                    android:id="@+id/muteIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_phone_mute"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_mute"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="@font/selawik_regular" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/incallKeypadButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginBottom="1dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_incall_control_rect">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_phone_keypad"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_tab_keypad"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="@font/selawik_regular" />
            </LinearLayout>

        </LinearLayout>

        <!-- Control row 2: speaker, hold -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/speakerButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="1dp"
                android:layout_marginBottom="1dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_incall_control_rect">
                <ImageView
                    android:id="@+id/speakerIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_phone_speaker"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_speaker"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="@font/selawik_regular" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/holdButton"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginBottom="1dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_incall_control_rect">
                <ImageView
                    android:id="@+id/holdIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_phone_hold"
                    android:layout_marginEnd="8dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_hold"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="18sp"
                    android:fontFamily="@font/selawik_regular" />
            </LinearLayout>

        </LinearLayout>

        <!-- End call button: full-width red rectangle -->
        <TextView
            android:id="@+id/endCallButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center"
            android:text="@string/phone_end_call"
            android:textColor="@color/wp_white"
            android:textSize="18sp"
            android:fontFamily="@font/selawik_regular"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_end_call_button" />

    </LinearLayout>

</LinearLayout>
