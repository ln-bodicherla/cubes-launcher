<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/wpBackground">

    <!-- Spacer pushes keypad to bottom -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Number display area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical|end"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:minHeight="72dp">

        <TextView
            android:id="@+id/numberDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="50sp"
            android:fontFamily="@font/selawik_light"
            android:gravity="end|center_vertical"
            android:maxLines="1"
            android:ellipsize="start" />

        <ImageView
            android:id="@+id/backspaceButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/ic_phone_backspace"
            android:contentDescription="@string/phone_backspace"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="gone" />

    </LinearLayout>

    <!-- T9 contact search results (hidden by default) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/t9Results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false" />

    <!-- 3x4 Dial pad: full-width boxy rectangular buttons -->
    <!-- Row 1: 1, 2 ABC, 3 DEF -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/key1"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/key2"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" ABC"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/key3"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" DEF"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Row 2: 4 GHI, 5 JKL, 6 MNO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/key4"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" GHI"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/key5"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" JKL"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/key6"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" MNO"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Row 3: 7 PQRS, 8 TUV, 9 WXYZ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/key7"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="7"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" PQRS"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/key8"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" TUV"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/key9"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" WXYZ"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular"
                android:layout_marginStart="6dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Row 4: *, 0+, # -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/keyStar"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="*"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/key0"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" +"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="17sp"
                android:fontFamily="@font/selawik_regular"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/keyHash"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1"
            android:layout_marginBottom="1dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_dial_key_rect">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="#"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="46sp"
                android:fontFamily="@font/selawik_light" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom row: call and save buttons (flat boxy rectangles) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/callButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:layout_marginEnd="1dp"
            android:gravity="center"
            android:text="@string/phone_call"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="17sp"
            android:fontFamily="@font/selawik_regular"
            android:textAllCaps="false"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_phone_bottom_button" />

        <TextView
            android:id="@+id/saveButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/phone_save"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="17sp"
            android:fontFamily="@font/selawik_regular"
            android:textAllCaps="false"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/bg_phone_bottom_button" />

    </LinearLayout>

    <!-- SIM selector (hidden on single-SIM devices) -->
    <TextView
        android:id="@+id/simSelector"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center"
        android:textColor="?attr/wpTextPrimary"
        android:textSize="17sp"
        android:fontFamily="@font/selawik_regular"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/bg_dial_key_rect"
        android:visibility="gone" />

</LinearLayout>
