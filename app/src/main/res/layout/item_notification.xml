<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/wp_notification_bg"
    android:padding="@dimen/notification_item_padding"
    android:layout_marginBottom="2dp"
    android:gravity="top">

    <!-- App icon -->
    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="@dimen/notification_app_icon_size"
        android:layout_height="@dimen/notification_app_icon_size"
        android:layout_marginEnd="12dp"
        android:contentDescription="App icon" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- App name + timestamp row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/appName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/wp_white_70"
                android:textSize="@dimen/notification_app_name_text_size"
                android:fontFamily="@font/selawik_regular"
                android:singleLine="true"
                android:textAllCaps="true"
                tools:text="MESSAGES" />

            <TextView
                android:id="@+id/timestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/wp_white_50"
                android:textSize="@dimen/notification_app_name_text_size"
                android:fontFamily="@font/selawik_regular"
                android:layout_marginStart="8dp"
                tools:text="2m ago" />

        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/notificationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/wp_white"
            android:textSize="@dimen/notification_title_text_size"
            android:fontFamily="@font/selawik_regular"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="John Doe" />

        <!-- Body -->
        <TextView
            android:id="@+id/notificationBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/wp_white_70"
            android:textSize="@dimen/notification_body_text_size"
            android:fontFamily="@font/selawik_regular"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Hey, are you free tonight?" />

    </LinearLayout>

    <!-- Dismiss button -->
    <ImageView
        android:id="@+id/dismissButton"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_close"
        android:contentDescription="@string/dismiss"
        android:padding="4dp"
        android:layout_marginStart="8dp" />

</LinearLayout>
