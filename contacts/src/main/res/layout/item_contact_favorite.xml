<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:layout_margin="1dp"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_dial_key_rect">

    <!-- Initials circle -->
    <TextView
        android:id="@+id/contactInitials"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:textColor="@color/wp_white"
        android:textSize="20sp"
        android:fontFamily="@font/selawik_regular"
        android:background="@drawable/bg_contact_initials_circle" />

    <!-- Contact name -->
    <TextView
        android:id="@+id/contactName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="?attr/wpTextPrimary"
        android:textSize="16sp"
        android:fontFamily="@font/selawik_regular"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="center"
        android:paddingTop="8dp" />

</LinearLayout>
