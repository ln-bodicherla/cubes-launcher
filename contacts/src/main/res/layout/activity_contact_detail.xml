<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/wpBackground"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header: name + initials -->
        <LinearLayout
            android:id="@+id/headerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="48dp"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/contactInitials"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:gravity="center"
                android:textColor="@color/wp_white"
                android:textSize="24sp"
                android:fontFamily="@font/selawik_regular"
                android:background="@drawable/bg_contact_initials_circle"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/contactName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="40sp"
                android:fontFamily="@font/selawik_light"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/actionCall"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="1dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_dial_key_rect">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_phone_call"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contacts_call"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="17sp"
                    android:fontFamily="@font/selawik_regular" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionMessage"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="1dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_dial_key_rect">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_phone_message"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contacts_message"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="17sp"
                    android:fontFamily="@font/selawik_regular" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionEmail"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_dial_key_rect">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_contacts_email"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contacts_send_email"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="17sp"
                    android:fontFamily="@font/selawik_regular" />
            </LinearLayout>

        </LinearLayout>

        <!-- Phone numbers section -->
        <TextView
            android:id="@+id/phonesLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contacts_phone"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textSize="16sp"
            android:fontFamily="@font/selawik_semibold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:textColor="?attr/wpTextSecondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/phonesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Email addresses section -->
        <TextView
            android:id="@+id/emailsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contacts_email"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:textSize="16sp"
            android:fontFamily="@font/selawik_semibold"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:textColor="?attr/wpTextSecondary"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/emailsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- Account info -->
        <TextView
            android:id="@+id/accountInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="15sp"
            android:fontFamily="@font/selawik_regular"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="24dp"
            android:visibility="gone" />

        <!-- Bottom action buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/actionStar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="4dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_dial_key_rect">
                <ImageView
                    android:id="@+id/starIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_contacts_star_outline"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/starLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="star"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="16sp"
                    android:fontFamily="@font/selawik_regular" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionEdit"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_dial_key_rect">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_contacts_edit"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contacts_edit"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="16sp"
                    android:fontFamily="@font/selawik_regular" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/actionDelete"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:background="@drawable/bg_dial_key_rect">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_contacts_delete"
                    android:contentDescription="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/contacts_delete"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="16sp"
                    android:fontFamily="@font/selawik_regular" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
