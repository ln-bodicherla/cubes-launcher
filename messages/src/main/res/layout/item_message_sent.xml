<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_message_sent"
        android:padding="@dimen/message_bubble_padding">

        <!-- Quote -->
        <View
            android:id="@+id/quoteBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/wp_white"
            android:visibility="gone" />

        <TextView
            android:id="@+id/quoteSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wp_white"
            android:textSize="12sp"
            android:fontFamily="@font/selawik_semibold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/quoteBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wp_white"
            android:textSize="12sp"
            android:fontFamily="@font/selawik_regular"
            android:alpha="0.7"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/wp_white"
            android:textSize="@dimen/message_body_size"
            android:fontFamily="@font/selawik_regular" />

        <TextView
            android:id="@+id/editedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(edited)"
            android:textColor="@color/wp_white"
            android:textSize="11sp"
            android:fontFamily="@font/selawik_regular"
            android:alpha="0.6"
            android:visibility="gone" />

    </LinearLayout>

    <TextView
        android:id="@+id/deliveryStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="12dp"
        android:textColor="?attr/wpTextSecondary"
        android:textSize="@dimen/message_delivery_size"
        android:fontFamily="@font/selawik_regular"
        android:visibility="gone" />

</FrameLayout>
