<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Initials circle -->
    <TextView
        android:id="@+id/participantInitials"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:textColor="@color/wp_white"
        android:textSize="14sp"
        android:fontFamily="@font/selawik_semibold"
        android:background="@drawable/bg_contact_initials_circle" />

    <!-- Name and role -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            android:id="@+id/participantName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="16sp"
            android:fontFamily="@font/selawik_regular"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/participantRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="12sp"
            android:fontFamily="@font/selawik_regular"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
