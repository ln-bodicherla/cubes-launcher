<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?attr/wpBackground">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ImageView
            android:id="@+id/backButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_back_arrow"
            android:contentDescription="Back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy Settings"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="24sp"
            android:fontFamily="@font/selawik_semibold"
            android:paddingStart="12dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Status/About -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About / Status Message"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="14sp"
                android:fontFamily="@font/selawik_semibold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/statusEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter your about text"
                android:textColor="?attr/wpTextPrimary"
                android:textColorHint="?attr/wpTextSecondary"
                android:textSize="16sp"
                android:fontFamily="@font/selawik_regular"
                android:background="?attr/wpSurface"
                android:padding="12dp"
                android:maxLines="3"
                android:inputType="textMultiLine" />

            <TextView
                android:id="@+id/saveStatusButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textSize="15sp"
                android:fontFamily="@font/selawik_semibold"
                android:padding="12dp"
                android:layout_marginTop="4dp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/wpTextSecondary"
                android:alpha="0.2"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />

            <!-- Blocked Contacts -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blocked Contacts"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="14sp"
                android:fontFamily="@font/selawik_semibold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/blockedCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textColor="?attr/wpTextPrimary"
                android:textSize="16sp"
                android:fontFamily="@font/selawik_regular"
                android:background="?attr/wpSurface"
                android:padding="12dp"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
