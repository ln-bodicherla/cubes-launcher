<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/wpBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="64dp"
        android:paddingBottom="48dp">

        <!-- Header with back arrow + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:src="@drawable/ic_back_arrow"
                android:background="@drawable/bg_wp10_back_button"
                android:backgroundTint="?attr/wpTextPrimary"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/messages_settings_title"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="@dimen/settings_title_text_size"
                android:fontFamily="@font/selawik_light"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- ==================== DISPLAY SECTION ==================== -->
        <TextView
            android:id="@+id/sectionDisplay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/messages_settings_display_section"
            android:textSize="@dimen/settings_section_text_size"
            android:fontFamily="@font/selawik_semibold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp" />

        <!-- Conversation list text size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/messages_settings_list_text_size"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="@dimen/settings_label_text_size"
                android:fontFamily="@font/selawik_regular" />

            <SeekBar
                android:id="@+id/listTextScaleSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="5"
                android:progress="2"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/listTextScalePreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/messages_settings_text_size_preview"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="@dimen/settings_label_text_size"
                android:fontFamily="@font/selawik_regular" />

        </LinearLayout>

        <!-- Message text size -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/messages_settings_message_text_size"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="@dimen/settings_label_text_size"
                android:fontFamily="@font/selawik_regular" />

            <SeekBar
                android:id="@+id/messageTextScaleSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="5"
                android:progress="2"
                android:paddingTop="8dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/messageTextScalePreview"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/messages_settings_text_size_preview"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="@dimen/settings_label_text_size"
                android:fontFamily="@font/selawik_regular" />

        </LinearLayout>

        <!-- ==================== SWIPE ACTIONS SECTION ==================== -->
        <TextView
            android:id="@+id/sectionSwipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/messages_settings_swipe_section"
            android:textSize="@dimen/settings_section_text_size"
            android:fontFamily="@font/selawik_semibold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="12dp" />

        <!-- Swipe right action -->
        <LinearLayout
            android:id="@+id/swipeRightRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/messages_settings_swipe_right"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="@dimen/settings_label_text_size"
                android:fontFamily="@font/selawik_regular" />

            <TextView
                android:id="@+id/swipeRightValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="@dimen/settings_desc_text_size"
                android:fontFamily="@font/selawik_regular" />

        </LinearLayout>

        <!-- Swipe left action -->
        <LinearLayout
            android:id="@+id/swipeLeftRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/messages_settings_swipe_left"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="@dimen/settings_label_text_size"
                android:fontFamily="@font/selawik_regular" />

            <TextView
                android:id="@+id/swipeLeftValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="@dimen/settings_desc_text_size"
                android:fontFamily="@font/selawik_regular" />

        </LinearLayout>

        <!-- ==================== SMS SECTION ==================== -->
        <TextView
            android:id="@+id/sectionSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/messages_settings_sms_section"
            android:textSize="@dimen/settings_section_text_size"
            android:fontFamily="@font/selawik_semibold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp" />

        <!-- SMS delivery confirmation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messages_settings_sms_delivery"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="@dimen/settings_label_text_size"
                    android:fontFamily="@font/selawik_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messages_settings_sms_delivery_desc"
                    android:textColor="?attr/wpTextSecondary"
                    android:textSize="@dimen/settings_desc_text_size"
                    android:fontFamily="@font/selawik_regular"
                    android:paddingTop="2dp" />

            </LinearLayout>

            <Switch
                android:id="@+id/smsDeliverySwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <!-- ==================== MMS SECTION ==================== -->
        <TextView
            android:id="@+id/sectionMms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/messages_settings_mms_section"
            android:textSize="@dimen/settings_section_text_size"
            android:fontFamily="@font/selawik_semibold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="12dp" />

        <!-- MMS delivery confirmation -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messages_settings_mms_delivery"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="@dimen/settings_label_text_size"
                    android:fontFamily="@font/selawik_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messages_settings_mms_delivery_desc"
                    android:textColor="?attr/wpTextSecondary"
                    android:textSize="@dimen/settings_desc_text_size"
                    android:fontFamily="@font/selawik_regular"
                    android:paddingTop="2dp" />

            </LinearLayout>

            <Switch
                android:id="@+id/mmsDeliverySwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <!-- Auto-download MMS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messages_settings_mms_auto_download"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="@dimen/settings_label_text_size"
                    android:fontFamily="@font/selawik_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messages_settings_mms_auto_download_desc"
                    android:textColor="?attr/wpTextSecondary"
                    android:textSize="@dimen/settings_desc_text_size"
                    android:fontFamily="@font/selawik_regular"
                    android:paddingTop="2dp" />

            </LinearLayout>

            <Switch
                android:id="@+id/mmsAutoDownloadSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <!-- Group messaging -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messages_settings_group_messaging"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="@dimen/settings_label_text_size"
                    android:fontFamily="@font/selawik_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messages_settings_group_messaging_desc"
                    android:textColor="?attr/wpTextSecondary"
                    android:textSize="@dimen/settings_desc_text_size"
                    android:fontFamily="@font/selawik_regular"
                    android:paddingTop="2dp" />

            </LinearLayout>

            <Switch
                android:id="@+id/groupMessagingSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <!-- ==================== WHATSAPP SECTION (hidden) ==================== -->
        <TextView
            android:id="@+id/sectionWhatsApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/messages_settings_whatsapp_section"
            android:textSize="@dimen/settings_section_text_size"
            android:fontFamily="@font/selawik_semibold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="12dp"
            android:visibility="gone" />

        <!-- Enable WhatsApp (hidden) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messages_settings_whatsapp_enable"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="@dimen/settings_label_text_size"
                    android:fontFamily="@font/selawik_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/messages_settings_whatsapp_enable_desc"
                    android:textColor="?attr/wpTextSecondary"
                    android:textSize="@dimen/settings_desc_text_size"
                    android:fontFamily="@font/selawik_regular"
                    android:paddingTop="2dp" />

            </LinearLayout>

            <Switch
                android:id="@+id/whatsappEnableSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <!-- WhatsApp account status -->
        <LinearLayout
            android:id="@+id/whatsappAccountRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/messages_settings_whatsapp_account"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="@dimen/settings_label_text_size"
                android:fontFamily="@font/selawik_regular" />

            <TextView
                android:id="@+id/whatsappAccountStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/messages_settings_whatsapp_not_linked"
                android:textColor="?attr/wpTextSecondary"
                android:textSize="@dimen/settings_desc_text_size"
                android:fontFamily="@font/selawik_regular" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
