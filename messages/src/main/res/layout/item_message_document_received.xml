<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="64dp"
        android:background="?attr/wpSurface"
        android:padding="@dimen/message_bubble_padding">

        <TextView
            android:id="@+id/senderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="13sp"
            android:fontFamily="@font/selawik_semibold"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/docIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_messages_attach"
                android:scaleType="centerInside"
                android:contentDescription="Document icon" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/fileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="@dimen/message_body_size"
                    android:fontFamily="@font/selawik_regular"
                    android:ellipsize="middle"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/fileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/wpTextSecondary"
                    android:textSize="@dimen/message_delivery_size"
                    android:fontFamily="@font/selawik_regular" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
