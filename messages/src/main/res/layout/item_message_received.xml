<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="64dp"
        android:background="?attr/wpSurface"
        android:padding="@dimen/message_bubble_padding">

        <TextView
            android:id="@+id/senderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="13sp"
            android:fontFamily="@font/selawik_semibold"
            android:visibility="gone" />

        <!-- Quote -->
        <View
            android:id="@+id/quoteBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/wpTextSecondary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/quoteSenderName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="12sp"
            android:fontFamily="@font/selawik_semibold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/quoteBody"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="12sp"
            android:fontFamily="@font/selawik_regular"
            android:alpha="0.7"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/messageText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="@dimen/message_body_size"
            android:fontFamily="@font/selawik_regular" />

        <TextView
            android:id="@+id/editedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="(edited)"
            android:textColor="?attr/wpTextSecondary"
            android:textSize="11sp"
            android:fontFamily="@font/selawik_regular"
            android:alpha="0.6"
            android:visibility="gone" />

    </LinearLayout>

</FrameLayout>
