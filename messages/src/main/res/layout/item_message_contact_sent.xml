<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:id="@+id/bubbleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_message_sent"
        android:padding="@dimen/message_bubble_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/contactIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/sym_contact_card"
                android:scaleType="centerInside"
                android:tint="@color/wp_white"
                android:contentDescription="Contact icon" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/contactDisplayName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/wp_white"
                    android:textSize="16sp"
                    android:fontFamily="@font/selawik_semibold" />

                <TextView
                    android:id="@+id/contactPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/wp_white"
                    android:textSize="13sp"
                    android:fontFamily="@font/selawik_regular" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/addContactAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Add to contacts"
            android:textColor="@color/wp_white"
            android:textSize="13sp"
            android:fontFamily="@font/selawik_regular"
            android:textStyle="normal" />

    </LinearLayout>

    <TextView
        android:id="@+id/deliveryStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="12dp"
        android:textColor="?attr/wpTextSecondary"
        android:textSize="@dimen/message_delivery_size"
        android:fontFamily="@font/selawik_regular"
        android:visibility="gone" />

</FrameLayout>
