<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:background="?attr/wpRippleOverlay"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/cityNameText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/wpTextPrimary"
        android:textSize="18sp"
        android:fontFamily="@font/selawik_regular"
        tools:text="San Francisco" />

    <TextView
        android:id="@+id/locationDetailText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/wpTextSecondary"
        android:textSize="14sp"
        android:fontFamily="@font/selawik_regular"
        android:layout_marginTop="2dp"
        tools:text="California, United States" />

</LinearLayout>
