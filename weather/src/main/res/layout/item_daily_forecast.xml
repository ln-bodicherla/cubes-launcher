<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/dayNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?attr/wpTextPrimary"
        android:textSize="16sp"
        android:fontFamily="@font/selawik_regular"
        tools:text="Mon" />

    <ImageView
        android:id="@+id/weatherIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        tools:src="@drawable/ic_weather_clear" />

    <TextView
        android:id="@+id/highTempText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/wpTextPrimary"
        android:textSize="16sp"
        android:fontFamily="@font/selawik_regular"
        tools:text="78\u00B0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/temp_separator"
        android:textColor="?attr/wpTextSecondary"
        android:textSize="16sp"
        android:fontFamily="@font/selawik_regular"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp" />

    <TextView
        android:id="@+id/lowTempText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/wpTextSecondary"
        android:textSize="16sp"
        android:fontFamily="@font/selawik_regular"
        tools:text="62\u00B0" />

</LinearLayout>
