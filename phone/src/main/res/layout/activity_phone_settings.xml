<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/wpBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="64dp"
        android:paddingBottom="48dp">

        <!-- Header with back arrow + title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="24dp"
            android:paddingBottom="32dp">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:src="@drawable/ic_back_arrow"
                android:background="@drawable/bg_wp10_back_button"
                android:backgroundTint="?attr/wpTextPrimary"
                android:contentDescription="Back"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/phone_settings_title"
                android:textColor="?attr/wpTextPrimary"
                android:textSize="@dimen/settings_title_text_size"
                android:fontFamily="@font/selawik_light"
                android:layout_marginStart="4dp" />

        </LinearLayout>

        <!-- ==================== CALLER ID SECTION ==================== -->
        <TextView
            android:id="@+id/sectionCallerId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_settings_caller_id_section"
            android:textSize="@dimen/settings_section_text_size"
            android:fontFamily="@font/selawik_semibold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="12dp" />

        <!-- Show my caller ID -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_settings_show_caller_id"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="@dimen/settings_label_text_size"
            android:fontFamily="@font/selawik_regular"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp" />

        <Spinner
            android:id="@+id/callerIdSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="?attr/wpSurfaceDim" />

        <!-- ==================== CALLS SECTION ==================== -->
        <TextView
            android:id="@+id/sectionCalls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_settings_calls_section"
            android:textSize="@dimen/settings_section_text_size"
            android:fontFamily="@font/selawik_semibold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="12dp" />

        <!-- Call waiting -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_settings_call_waiting"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="@dimen/settings_label_text_size"
                    android:fontFamily="@font/selawik_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_settings_call_waiting_desc"
                    android:textColor="?attr/wpTextSecondary"
                    android:textSize="@dimen/settings_desc_text_size"
                    android:fontFamily="@font/selawik_regular"
                    android:paddingTop="2dp" />

            </LinearLayout>

            <Switch
                android:id="@+id/callWaitingSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <!-- International assist -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_settings_international_assist"
                    android:textColor="?attr/wpTextPrimary"
                    android:textSize="@dimen/settings_label_text_size"
                    android:fontFamily="@font/selawik_regular" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/phone_settings_international_assist_desc"
                    android:textColor="?attr/wpTextSecondary"
                    android:textSize="@dimen/settings_desc_text_size"
                    android:fontFamily="@font/selawik_regular"
                    android:paddingTop="2dp" />

            </LinearLayout>

            <Switch
                android:id="@+id/internationalAssistSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp" />

        </LinearLayout>

        <!-- ==================== VOICEMAIL SECTION ==================== -->
        <TextView
            android:id="@+id/sectionVoicemail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_settings_voicemail_section"
            android:textSize="@dimen/settings_section_text_size"
            android:fontFamily="@font/selawik_semibold"
            android:textAllCaps="true"
            android:letterSpacing="0.05"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="12dp" />

        <!-- Voicemail number -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/phone_settings_voicemail_number"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="@dimen/settings_label_text_size"
            android:fontFamily="@font/selawik_regular"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp" />

        <EditText
            android:id="@+id/voicemailNumberEdit"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:background="?attr/wpSurfaceDim"
            android:textColor="?attr/wpTextPrimary"
            android:textSize="@dimen/settings_label_text_size"
            android:fontFamily="@font/selawik_regular"
            android:hint="@string/phone_settings_voicemail_hint"
            android:textColorHint="?attr/wpTextSecondary"
            android:inputType="phone"
            android:singleLine="true" />

    </LinearLayout>

</ScrollView>
